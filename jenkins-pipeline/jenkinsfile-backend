pipeline {
    agent any 

    tools {
        jdk 'jdk'
        nodejs 'nodejs'
    }

    environment  {
        SCANNER_HOME = tool 'sonar-scanner'
        AWS_ACCOUNT_ID = credentials('ACCOUNT_ID')
        AWS_ECR_REPO_NAME = credentials('ECR_REPO_BACKEND')
        AWS_DEFAULT_REGION = 'us-west-2'
        REPOSITORY_URI = "${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_DEFAULT_REGION}.amazonaws.com/"
    }

    stages {

        stage('Cleaning Workspace') {
            steps {
                cleanWs()
            }
        }

        stage('Checkout from Git') {
            steps {
                git branch: 'main',
                    credentialsId: 'GITHUB',
                    url: 'https://github.com/riteshtorne150/three-tier-devsecops-project.git'
            }
        }

        stage('Sonarqube Analysis') {
            steps {
                dir('app-code/backend') {
                    withSonarQubeEnv('sonar-server') {
                        sh ''' 
                            $SCANNER_HOME/bin/sonar-scanner \
                            -Dsonar.projectKey=backend \
                            -Dsonar.sources=. \
                            -Dsonar.host.url=http://32.185.242.140:9000 \
                            -Dsonar.login=sqp_b4ef7d847a9df3afbed355748a57933f8593d23b
                        '''
                    }
                }
            }
        }

        stage('Quality Check') {
            steps {
                script {
                    waitForQualityGate abortPipeline: false,
                        credentialsId: 'sonar-token'
                }
            }
        }

        //stage('OWASP Dependency-Check Scan') {
            //steps {
                //dir('app-code/backend') {
                    //dependencyCheck additionalArguments: '--scan ./ --disableYarnAudit --disableNodeAudit',
                        //odcInstallation: 'DP-Check'

                    //dependencyCheckPublisher pattern: '**/dependency-check-report.xml'
                //}
            //}
        //}

        stage('Trivy File Scan') {
            steps {
                dir('app-code/backend') {
                    sh 'trivy fs . > trivyfs.txt || true'
                }
            }
        }

        stage("Docker Image Build") {
            steps {
                script {
                    dir('app-code/backend') {
                        sh 'docker system prune -f'
                        sh 'docker container prune -f'
                        sh 'docker build -t ${AWS_ECR_REPO_NAME} .'
                    }
                }
            }
        }

        stage("ECR Image Pushing") {
            steps {
                script {
                    sh 'aws ecr get-login-password --region ${AWS_DEFAULT_REGION} | docker login --username AWS --password-stdin ${REPOSITORY_URI}'

                    sh 'docker tag ${AWS_ECR_REPO_NAME} ${REPOSITORY_URI}${AWS_ECR_REPO_NAME}:${BUILD_NUMBER}'

                    sh 'docker push ${REPOSITORY_URI}${AWS_ECR_REPO_NAME}:${BUILD_NUMBER}'
                }
            }
        }

        stage("TRIVY Image Scan") {
            steps {
                sh 'trivy image ${REPOSITORY_URI}${AWS_ECR_REPO_NAME}:${BUILD_NUMBER} > trivyimage.txt || true'
            }
        }

        stage('Checkout Code') {
            steps {
                git branch: 'main',
                    credentialsId: 'GITHUB',
                    url: 'https://github.com/riteshtorne150/three-tier-devsecops-project.git'
            }
        }

        stage('Update Deployment file') {

            environment {
                GIT_REPO_NAME = "three-tier-devsecops-project"
                GIT_USER_NAME = "riteshtorne150"
            }

            steps {

                dir('kubernetes-manifests/backend') {

                    withCredentials([
                        string(
                            credentialsId: 'github',
                            variable: 'GITHUB_TOKEN'
                        )
                    ]) {

                        sh '''
                            set -eux

                            echo "=========================================="
                            echo "Starting Deployment File Update"
                            echo "=========================================="

                            git config user.email "rashiddaha80@gmail.com"
                            git config user.name "riteshtorne150"

                            echo "BUILD_NUMBER = ${BUILD_NUMBER}"

                            imageTag=$(grep -oP '(?<=backend:)[^ ]+' deployment.yaml)

                            echo "Current Image Tag = ${imageTag}"
                            echo "New Image Tag = ${BUILD_NUMBER}"

                            sed -i "s/${AWS_ECR_REPO_NAME}:${imageTag}/${AWS_ECR_REPO_NAME}:${BUILD_NUMBER}/" deployment.yaml

                            echo "Deployment file after update:"
                            grep "${AWS_ECR_REPO_NAME}" deployment.yaml

                            git add deployment.yaml

                            git commit -m "Update deployment Image to version ${BUILD_NUMBER} [skip ci]" || true

                            echo "=========================================="
                            echo "Pushing changes to GitHub"
                            echo "=========================================="

                            git push https://${GITHUB_TOKEN}@github.com/${GIT_USER_NAME}/${GIT_REPO_NAME} HEAD:main

                            echo "=========================================="
                            echo "GIT PUSH SUCCESSFUL"
                            echo "=========================================="
                        '''
                    }
                }
            }
        }
    }

    post {

        success {
            echo "=========================================="
            echo "PIPELINE COMPLETED SUCCESSFULLY"
            echo "BUILD NUMBER: ${BUILD_NUMBER}"
            echo "=========================================="
        }

        failure {
            echo "=========================================="
            echo "PIPELINE FAILED"
            echo "BUILD NUMBER: ${BUILD_NUMBER}"
            echo "CHECK THE STAGE ABOVE FOR THE ERROR"
            echo "=========================================="
        }

        always {
            echo "Final Jenkins Build Result: ${currentBuild.currentResult}"
        }
    }
}